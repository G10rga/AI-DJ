      "html": "<article class=\"ds-preview\"><h3>8-bar EQ handoff</h3><p>2:08 · Handoff 1:04 · I Move (Lyrics) → F Say What</p><audio controls preload=\"metadata\" aria-label=\"8-bar EQ handoff preview playback\"></audio><div class=\"ds-preview-actions\"><button title=\"Starts four seconds before the handoff\">Play handoff 1:04</button><a href=\"#\" download>Download preview</a></div></article>",
      "css": ".ds-preview{font-family:Inter,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--text,#fff);padding:0 0 22px;margin-bottom:22px;border-bottom:1px solid #252525}.ds-preview h3{font-size:14px;font-weight:600;line-height:1.5;margin:0}.ds-preview p{font-size:12px;line-height:1.6;color:var(--muted,#b4b4b4);margin:6px 0 0;overflow-wrap:anywhere}.ds-preview audio{display:block;width:100%;height:42px;margin-top:12px;color-scheme:dark}.ds-preview-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;flex-wrap:wrap}.ds-preview-actions button{font-family:Inter,system-ui,sans-serif;font-size:13px;font-variant-numeric:tabular-nums;min-height:38px;border:1px solid var(--control,#444);border-radius:6px;padding:8px 11px;cursor:pointer;background:transparent;color:var(--text,#fff);font-size:12px}.ds-preview-actions a{font-size:12px;text-underline-offset:4px;color:var(--muted,#b4b4b4)}.ds-preview-actions button:hover{background:var(--raised,#242424)}.ds-preview-actions button:active{background:#333}.ds-preview-actions button:focus-visible,.ds-preview-actions a:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}@media(max-width:650px){.ds-preview-actions{justify-content:flex-start;gap:18px}}"
