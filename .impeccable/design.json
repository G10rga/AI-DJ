      "css": ".ds-input{font-family:Inter,system-ui,sans-serif;font-size:14px;font-variant-numeric:tabular-nums;min-height:38px;border:1px solid var(--control,#444);border-radius:6px;padding:8px 11px;cursor:pointer;cursor:text;min-width:0;width:100%;background:transparent;color:var(--text,#fff);caret-color:var(--accent,#c6f24e)}.ds-input::placeholder{color:#a2a2a2}.ds-input:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}"
    },
    {
      "name": "Track navigation",
      "kind": "nav",
      "refersTo": "track-current",
      "description": "Selected library entry with a wrapping filename and quiet subtitle.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Analyzed tracks\"><button aria-current=\"true\">I Move (Lyrics).mp3<small>Review musical timeline</small></button></nav>",
      "css": ".ds-nav{display:grid;gap:5px}.ds-nav button{font-family:Inter,system-ui,sans-serif;font-size:14px;font-variant-numeric:tabular-nums;min-height:38px;border:1px solid var(--control,#444);border-radius:6px;padding:8px 11px;cursor:pointer;text-align:left;min-height:62px;border:0;line-height:1.5;overflow-wrap:anywhere;padding:10px 12px;background:transparent;color:var(--muted,#b4b4b4)}.ds-nav button[aria-current=true]{background:var(--surface,#111);color:var(--text,#fff)}.ds-nav button:hover{background:var(--raised,#242424)}.ds-nav button:active{background:#333}.ds-nav button:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}.ds-nav button:disabled{opacity:.5;cursor:default}.ds-nav small{display:block;font-size:12px;margin-top:3px;color:var(--muted,#b4b4b4)}"
    },
    {
      "name": "Timeline container and view control",
      "kind": "custom",
      "refersTo": "timeline-panel",
      "description": "Flat listening surface and semantic legend; geometry is supplied only by real analysis at runtime.",
      "html": "<section class=\"ds-timeline\" aria-label=\"Musical timeline\"><div class=\"ds-heading\"><h2>Musical evidence</h2><label>View <select><option>Whole song</option><option>60 seconds</option><option>30 seconds</option></select></label></div><div class=\"ds-legend\"><span class=\"ds-energy\">Energy</span><span class=\"ds-vocal\">Vocal activity</span><span class=\"ds-downbeat\">Downbeat</span><span class=\"ds-phrase\">Phrase candidate</span></div></section>",
      "css": ".ds-timeline{font-family:Inter,system-ui,sans-serif;color:var(--text,#fff);background:var(--surface,#111);border-radius:12px;padding:20px}.ds-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.ds-heading h2{font-size:16px;font-weight:600;margin:0}.ds-heading label{font-size:12px;color:var(--muted,#b4b4b4);display:flex;align-items:center;gap:10px}.ds-heading select{font-family:Inter,system-ui,sans-serif;font-size:14px;font-variant-numeric:tabular-nums;min-height:38px;border:1px solid var(--control,#444);border-radius:6px;padding:8px 11px;cursor:pointer;background:var(--surface,#111);color:var(--text,#fff)}.ds-heading select:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}.ds-legend{display:flex;flex-wrap:wrap;gap:22px;color:var(--muted,#b4b4b4);font-size:12px;margin:20px 0 8px}.ds-legend span:before{content:'';display:inline-block;width:14px;height:3px;margin:0 7px 3px 0;background:var(--accent,#c6f24e)}.ds-legend .ds-vocal:before{background:#888;height:8px;margin-bottom:0}.ds-legend .ds-downbeat:before{background:#fff;width:2px;height:10px;margin-bottom:0}.ds-legend .ds-phrase:before{background:var(--warning,#e5a93b);width:2px;height:10px;margin-bottom:0}@media(max-width:650px){.ds-timeline{padding:16px 12px}.ds-heading{gap:10px}.ds-heading h2{font-size:15px}.ds-heading label{gap:6px}.ds-heading select{max-width:112px;font-size:12px}.ds-legend{gap:12px;font-size:11px}}"
    },
    {
      "name": "Marker table",
      "kind": "custom",
      "description": "Compact timing rows with right-aligned seek and removal actions; sampled values come from the reviewed screenshot.",
      "html": "<div class=\"ds-table-scroll\"><table class=\"ds-table\"><thead><tr><th>Marker</th><th>Time</th><th>Action</th></tr></thead><tbody><tr><td>Downbeat 1</td><td><button aria-label=\"Seek to 0.18 seconds\">0.18 s</button></td><td><button aria-label=\"Remove downbeat at 0.18 seconds\">Remove</button></td></tr></tbody></table></div>",
      "css": ".ds-table-scroll{max-height:245px;overflow:auto;scrollbar-color:#555 #111;scrollbar-width:thin}.ds-table{border-collapse:collapse;width:100%;font-family:Inter,system-ui,sans-serif;font-size:13px;font-variant-numeric:tabular-nums;color:var(--text,#fff)}.ds-table th{text-align:left;color:var(--muted,#b4b4b4);font-weight:400;position:sticky;top:0;background:var(--ground,#000)}.ds-table th,.ds-table td{padding:9px 4px;border-bottom:1px solid #252525}.ds-table td:nth-child(2),.ds-table th:nth-child(2),.ds-table td:last-child,.ds-table th:last-child{text-align:right}.ds-table button{font-family:Inter,system-ui,sans-serif;font-size:14px;font-variant-numeric:tabular-nums;min-height:38px;border:1px solid var(--control,#444);border-radius:6px;padding:8px 11px;cursor:pointer;font-size:13px;min-height:30px;padding:4px 8px;border:0;background:transparent;color:var(--text,#fff)}.ds-table button:hover{background:var(--raised,#242424)}.ds-table button:active{background:#333}.ds-table button:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}.ds-table button:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Shared text navigation between mix listening and source correction.",
      "html": "<nav class=\"ds-pages\" aria-label=\"Main navigation\"><a href=\"/mixes\" aria-current=\"page\">Mixes</a><a href=\"/timelines\">Timelines</a></nav>",
      "css": ".ds-pages{display:flex;gap:24px;font-family:Inter,system-ui,sans-serif}.ds-pages a{font-size:14px;font-weight:500;color:var(--muted,#b4b4b4);text-decoration:none}.ds-pages a[aria-current=page]{color:var(--text,#fff)}.ds-pages a:hover{text-decoration:underline}.ds-pages a:focus-visible{outline:2px solid var(--accent,#c6f24e);outline-offset:3px}@media(max-width:650px){.ds-pages{gap:18px}}"
